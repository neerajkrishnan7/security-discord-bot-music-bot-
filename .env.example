# ==============================================================================
# SPOOFY — Configuration & Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
DASHBOARD_URL=http://localhost:4000

# Discord Developer Portal Credentials
# Obtain at: https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_VALUE_HERE
CLIENT_ID=YOUR_VALUE_HERE
DISCORD_CLIENT_SECRET=YOUR_VALUE_HERE
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Master Discord Account ID (Global Project Owner bypasses all checks)
BOT_OWNER_ID=YOUR_VALUE_HERE

# Optional Dev Target Guild ID
GUILD_ID=YOUR_VALUE_HERE

# Security, JWT & Session Secrets
API_SECRET=GENERATE_A_RANDOM_SECRET
SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET

# Database & Cache (PostgreSQL & Redis for production Docker setup)
# For local dev without Docker, SPOOFY defaults to embedded SQLite (spoofy.sqlite) automatically.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?schema=public
REDIS_URL=redis://localhost:6379

# PostgreSQL Credentials (for docker-compose)
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=CHANGE_ME

# Music Service (Lavalink Node Configuration)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CHANGE_ME
LAVALINK_SECURE=false

# Feature Flags & Testing
ENABLE_SIMULATOR=true
